---
layout: default
---
<div class="post-layout">
  <div class="post-header">
    <% if data.is_cta %>
      <span class="post-badge cta">Call for Speakers</span>
    <% else %>
      <span class="post-badge event">
        Event Date: <%= data.event_date %>
      </span>
    <% end %>
    
    <h1 class="post-title"><%= data.title %></h1>
    
    <div class="post-actions">
      <% if data.is_cta %>
        <a href="mailto:rubyaz@heiligers.us?subject=I'd like to speak at RubyAZ" class="btn--primary-alt">Contact Us</a>
      <% else %>
        <a href="<%= data.meetup_link || 'https://www.meetup.com/ruby-az/' %>" target="_blank" class="btn--secondary">RSVP on Meetup</a>
      <% end %>
    </div>
  </div>
  
  <div class="post-content">
    <%= yield %>
  </div>
  
  <div class="post-footer">
    <a href="/" class="post-back-link">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
      <span>Back to Home</span>
    </a>
  </div>
</div>
