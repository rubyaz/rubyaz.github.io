<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title><%= resource.data.title ? "#{resource.data.title} | Ruby::AZ" : "Ruby::AZ" %></title>
    <meta name="description" content="<%= site.metadata.description %>">
    
    <!-- OpenGraph Meta Tags -->
    <meta property="og:title" content="<%= resource.data.title || 'Ruby::AZ' %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= absolute_url(resource.relative_url) %>">
    <meta property="og:image" content="<%= absolute_url('/images/logo.webp') %>">
    <meta property="og:description" content="<%= site.metadata.description %>">
    
    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@Ruby_AZ">
    <meta name="twitter:title" content="<%= resource.data.title || 'Ruby::AZ' %>">
    <meta name="twitter:description" content="<%= site.metadata.description %>">
    <meta name="twitter:image" content="<%= absolute_url('/images/logo.webp') %>">
    <style>
        @font-face {
          font-family: 'Peralta';
          src: url('/fonts/Peralta.woff2') format('woff2');
          font-weight: normal;
          font-style: normal;
        }
        @font-face {
          font-family: 'National Park';
          src: url('/fonts/National_Park.woff') format('woff');
          font-weight: normal;
          font-style: normal;
        }
        @layer base{html,body{margin:0;padding:0;scroll-behavior:smooth;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}
    </style>
    <link rel="stylesheet" href="<%= asset_path :css %>" />
    <link rel="alternate" type="application/atom+xml" title="RubyAZ Meetup Events" href="/feed.xml">
    <link rel="icon" type="image/webp" href="/favicon.webp">
    <%= live_reload_dev_js %>
</head>

<body class="bg-surface font-body-md text-body-md text-on-surface">
    <header class="site-header">
        <div class="header-container">
            <div class="logo-group">
                <a href="/" class="logo-group">
                    <img alt="RubyAZ Logo" class="logo-img" src="/images/logo.webp">
                    <span class="logo-text">Ruby::AZ</span>
                </a>
            </div>
            <nav class="nav-desktop" data-active-classes="active-nav">
                <a class="nav-link" href="/#upcoming-events">Upcoming Events</a>
                <a class="nav-link" href="/#past-events">Past Events</a>
                <a class="nav-link" href="/#sponsors">Sponsors</a>
            </nav>
            <div class="header-actions">
                <a class="btn--primary" href="https://www.meetup.com/ruby-az/" target="_blank">
                  <span class="mobile-text">Join</span>
                  <span class="desktop-text">Join on Meetup</span>
                </a>
            </div>
        </div>
    </header>
    <main class="main-content">
        <%= yield %>
    </main>
    <footer class="site-footer">
        <div class="footer-container">
            <div class="footer-brand">
                <div class="footer-logo">
                    <img alt="RubyAZ Logo" src="/images/logo.webp">
                    <span class="footer-logo-text">Ruby::AZ</span>
                </div>
                <p class="footer-tagline">The Arizona Ruby User Group</p>
            </div>
            <div class="footer-meta">
                <span>© <%= Time.now.year %> Ruby::AZ. Built with 💎, ❤️ and lots of ☀️</span>
                <span class="footer-separator">|</span>
                <div class="footer-links">
                    <a href="https://ruby.social/@Ruby_AZ" target="_blank" rel="me" class="footer-link" title="Follow us on Mastodon">
                        <svg viewBox="0 0 448 512" fill="currentColor"><path d="M433 179.11c0-97.2-63.71-125.7-63.71-125.7-62.52-28.7-228.56-28.4-290.48 0 0 0-63.72 28.5-63.72 125.7 0 115.7-6.6 259.4 105.63 289.1 40.51 10.7 75.32 13 103.33 11.4 50.81-2.8 79.32-18.1 79.32-18.1l-1.7-36.9s-36.31 11.4-77.12 10.1c-40.41-1.4-83-4.4-89.63-54a102.54 102.54 0 0 1-.9-13.9c85.63 20.9 158.65 9.1 178.75 6.7 56.12-6.7 105-41.3 111.23-72.9 9.8-49.8 9-121.5 9-121.5zm-75.12 125.2h-46.63v-114.2c0-49.7-64-51.6-64 6.9v62.5h-46.33V197c0-58.5-64-56.6-64-6.9v114.2H90.19c0-122.1-5.2-147.9 18.41-175 25.9-28.9 79.82-30.8 103.83 6.1l11.6 19.5 11.6-19.5c24.11-37.1 78.12-34.8 103.83-6.1 23.71 27.3 18.4 53 18.4 175z"/></svg>
                        Mastodon
                    </a>
                    <a href="https://bsky.app/profile/rubyza.bsky.social" target="_blank" class="footer-link" title="Follow us on Bluesky">
                        <svg viewBox="0 0 568 501" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M123.121 33.6637C188.241 82.5526 258.281 181.681 284 234.873C309.719 181.681 379.759 82.5526 444.879 33.6637C491.866 -1.61183 568 -28.9064 568 57.9464C568 75.2916 558.055 203.659 552.222 224.501C531.947 296.954 458.067 315.434 392.347 304.249C507.222 323.8 536.444 388.56 473.333 453.32C353.473 576.312 301.061 422.461 287.631 383.039C285.169 375.812 284.017 372.431 284 375.306C283.983 372.431 282.831 375.812 280.369 383.039C266.939 422.461 214.527 576.312 94.6667 453.32C31.5556 388.56 60.7778 323.8 175.653 304.249C109.933 315.434 36.0535 296.954 15.7778 224.501C9.94525 203.659 0 75.2916 0 57.9464C0 -28.9064 76.1345 -1.61183 123.121 33.6637Z" fill="currentColor"/></svg>
                        Bluesky
                    </a>
                    <a href="/feed.xml" target="_blank" class="footer-link" title="RSS Feed">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 8"><style>.symbol{stroke:none;fill:var(--color-surface, #fff)}</style><rect width="8" height="8" rx="1.5" style="stroke:none;fill:currentColor"/><circle class="symbol" cx="2" cy="6" r="1"/><path class="symbol" d="M1 4a3 3 0 0 1 3 3h1a4 4 0 0 0-4-4z"/><path class="symbol" d="M1 2a5 5 0 0 1 5 5h1a6 6 0 0 0-6-6z"/></svg>
                        RSS
                    </a>
                </div>
            </div>
        </div>
    </footer>
</body>

</html>
